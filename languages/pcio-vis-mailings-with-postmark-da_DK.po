#: pcio-vis-postmark.php:51 pcio-vis-postmark.php:52
msgid "Postmark"
msgstr "Postmark"

#: pcio-vis-postmark.php:65
msgid "Insufficient permissions."
msgstr "Utilstrækkelige rettigheder."

#: pcio-vis-postmark.php:78
msgid "Postmark settings saved."
msgstr "Postmark-indstillinger gemt."

#: pcio-vis-postmark.php:85
msgid "Vis — Postmark Settings"
msgstr "Vis — Postmark-indstillinger"

#: pcio-vis-postmark.php:88
msgid "Used for bulk-sending mails to all members via the Postmark API. When these settings are blank the Mails page falls back to the standard WordPress mailer (wp_mail)."
msgstr "Bruges til masseudsendelse af mails til alle medlemmer via Postmark-API'et. Når disse felter er tomme, falder Mails-siden tilbage til den almindelige WordPress-mailer (wp_mail)."

#. translators: %s: postmarkapp.com URL
#: pcio-vis-postmark.php:92
msgid "Get your server API token from %s."
msgstr "Hent dit server-API-token fra %s."

#: pcio-vis-postmark.php:101
msgid "Server API Token"
msgstr "Server-API-token"

#: pcio-vis-postmark.php:107
msgid "Stored in the database. Never share this token."
msgstr "Opbevares i databasen. Del aldrig dette token."

#: pcio-vis-postmark.php:113
msgid "From Email"
msgstr "Afsender-e-mail"

#: pcio-vis-postmark.php:122
msgid "Must be a verified sender address in your Postmark account."
msgstr "Skal være en verificeret afsenderadresse i din Postmark-konto."

#: pcio-vis-postmark.php:128
msgid "From Name"
msgstr "Afsendernavn"

#: pcio-vis-postmark.php:135
msgid "Organisation name"
msgstr "Organisationens navn"

#: pcio-vis-postmark.php:141
msgid "Save Postmark settings"
msgstr "Gem Postmark-indstillinger"

#: pcio-vis-postmark.php:145
msgid "Current status"
msgstr "Nuværende status"

#: pcio-vis-postmark.php:149
msgid "Postmark is configured. Mails will be sent via the Postmark API."
msgstr "Postmark er konfigureret. Mails sendes via Postmark-API'et."

#: pcio-vis-postmark.php:155
msgid "Postmark is not fully configured. Mails will fall back to wp_mail()."
msgstr "Postmark er ikke fuldt konfigureret. Mails falder tilbage til wp_mail()."
